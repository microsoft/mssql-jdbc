# Non-secret local defaults. Copy to .env only if wanted; dev.sh does not source it.
# Compose reads this as data, not shell code. Never commit a populated .env.
OTEL_SERVICE_NAME=mssql-jdbc-connection-demo
OTEL_AUTH_MODE=none
DEMO_SCENARIOS=config,dns
DEMO_REPEAT=1
DEMO_PAUSE_SECONDS=1

# Set DEMO_WITH_SQL=true in the PROCESS environment to select the optional SQL overlay.
# Also set DEMO_STACK in the process environment for internal/delta modes.
# Supply a strong SA password externally; no usable default credential is provided.
MSSQL_SA_PASSWORD=
DEMO_LOGIN_PASSWORD=
# Optional safe nonexistent account (must not exist on your chosen SQL Server):
# DEMO_LOGIN_USER=jdbc_demo_deliberately_nonexistent_login
# SQL_SERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# Host discovery only: exact hostname, no scheme, path, wildcard or suffix matching.
# Mandatory with DEMO_DISCOVERY_CONNECTION_STRING when the explicit OTLP endpoint is unset.
# Discovered destinations must use HTTPS even when insecure demo flags are enabled.
OTEL_DISCOVERY_ALLOWED_HOST=

# Supply secrets via your process environment, not this template or command args:
# JDBC_CONNECTION_STRING; DEMO_LOGIN_USER (deliberately invalid); DEMO_LOGIN_PASSWORD
# DEMO_DISCOVERY_CONNECTION_STRING (optional separate bootstrap connection)
# OTEL_BEARER_TOKEN (static mode; short lived; never persisted in this file)
# AZURE_CLIENT_SECRET (default mode, only if intentionally using service principal)

# Internal overlay: no real tenant, subscription, resource, identity or image defaults.
# MISE_IMAGE=<approved immutable image tag or digest; see pinned upstream reference>
# OTELCOL_ARCDATA_IMAGE=<approved immutable image tag or digest>
# MISE_TENANT_ID=<tenant-guid>
# MISE_CLIENT_ID=<onboarded-mise-application-guid>
# MISE_AUDIENCE=<exact-validator-audience>
# MISE_REGION=<authorization-service-region>
# MISE_FIRST_PARTY_SUBSCRIPTION=<owner-approved-required-allowlist-value>
# MISE_CERT_PATH=<absolute-path-to-approved-pfx>
# MISE_CERT_PASSWORD is environment-only; an empty value is allowed for an unencrypted PFX.
# OTEL_AUTH_MODE=static
# OTEL_ACCESS_TOKEN_SCOPE=<exact-approved-callback-scope>
# OTEL_TOKEN_AUTHORITY=<explicit-authority-if-needed>
# OTEL_ARM_RESOURCE_ID=<exact-resource-to-authorize>

# Optional Delta overlay, with real externally supplied Managed Identity plumbing:
# DELTA_BULK_LOADER_IMAGE=<approved immutable image tag or digest>
# IDENTITY_ENDPOINT=<reachable-platform-managed-identity-endpoint>
# IDENTITY_HEADER is environment-only and REQUIRED, never a default shared secret.
# STORAGE_ACCOUNT=<account-name>
# STORAGE_CONTAINER=<container-name>
# ROOT_PATH=<isolated-demo-prefix>
# EVENT_HUB_NAMESPACE=<namespace-fqdn>
# EVENT_HUB_NAME=<hub-name>
# EVENT_HUB_CONSUMER_GROUP=<new-unique-demo-group-with-no-checkpoints>
# Set the group in the PROCESS environment; dev.sh rejects missing groups and $Default.
# Earliest may replay retained events. Never share this group with another consumer/demo.
# AZURE_TENANT_ID=<tenant-guid>
# CHECKPOINT_STORAGE_ACCOUNT=<checkpoint-account-name>
# CHECKPOINT_STORAGE_CONTAINER=<dedicated-checkpoint-container>