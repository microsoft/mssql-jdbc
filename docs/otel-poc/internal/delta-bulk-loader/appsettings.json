{
  "Logging": { "LogLevel": { "Default": "Warning", "Microsoft.Hosting.Lifetime": "Warning" } },
  "ParquetDotnetWriterConfiguration": {
    "CompressionMethod": "Snappy",
    "CompressionLevel": "SmallestSize",
    "ParquetCleanUpOnCancel": true
  },
  "DeltaWriterConfiguration": { "IsDevelopmentEnvironment": true },
  "EventHubReplicationConfiguration": {
    "ReplicationConfiguration": [
      {
        "SourceEventHubConfiguration": {
          "EventHubAuthType": "ManagedIdentityCredential",
          "Namespace": "",
          "Name": "",
          "EventHubTenantId": "",
          "ConsumerGroupName": "",
          "IngestionConfiguration": {
            "NumOrchestrators": 1,
            "MaxBatchSizePerCpu": 50,
            "PrefetchCount": 3000,
            "EventHubDefaultOffset": "Earliest"
          }
        },
        "SinkDeltaLakeConfiguration": [
          {
            "StorageAccountAuthTypeOverride": "ManagedIdentityCredential",
            "SinkName": "Delta Bulk Load Sink",
            "SinkNamespace": "OTAP connection-error trace tables",
